
@{
    ViewBag.Title = "editExtraActivity";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@section subHeader{
}
<div class="page-heading">
    <h1 class="page-title">New Class</h1>
</div>
<div class="page-content fade-in-up">
    <div class="row">
        <div class="col-md-6">
            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-tools">
                        <a class="ibox-collapse"><i class="fa fa-minus"></i></a>
                        <a class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item">option 1</a>
                            <a class="dropdown-item">option 2</a>
                        </div>
                    </div>
                </div>
                <div class="ibox-body">
                    @if (ViewBag.ActivityEdit != null)
                    {
                        var item1 = (OHD_System.Models.Entities.ExtracurricularActivity)ViewBag.ActivityEdit;
                        <form action="/ExtraActivity/changeactivity" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>Title</label>
                                    <input class="form-control" type="text" name="Title" placeholder="Title" value="@(item1 != null ? item1.Title : "")">
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label>Capacity</label>
                                    <input class="form-control" type="text" name="Capacity" placeholder="Capacity" value="@(item1 != null ? item1.Capacity : 0)">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 form-group">
                                    <label>Location</label>
                                    <input class="form-control" type="text" name="Location" placeholder="Location" value="@(item1 != null ? item1.Location : "")">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12 form-group">
                                    <label>Description</label>
                                    <textarea class="form-control" name="Description" placeholder="Description" rows="6">@(item1 != null ? item1.Description : "")</textarea>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>CreatedAt</label>
                                    <input class="form-control" type="date" name="CreatedAt" value="@(item1.CreatedAt != null ? ((DateTime)item1.CreatedAt).ToString("yyyy-MM-dd") : "")">
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label>ActivityDate</label>
                                    <input class="form-control" type="date" name="ActivityDate" value="@(item1.CreatedAt != null ? ((DateTime)item1.ActivityDate).ToString("yyyy-MM-dd") : "")">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="ui-checkbox">Status</label>
                                <input type="checkbox" name="Status" alt="Active or deactive" checked>
                            </div>
                            <div class="form-group">
                                <button class="btn btn-default" type="submit">Submit</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section subFooter{
}





