
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section subHeader{
    <link href="@Url.Content("~/content/Admin/assets/vendors/DataTables/datatables.min.css")" rel="stylesheet" />
}
@if (ViewBag.listExtraActivity != null)
{
    var ls = (List<OHD_System.Models.Entities.ExtracurricularActivity>)ViewBag.listExtraActivity;
    <div class="page-heading">
        <h1 class="page-title">Class List</h1>
    </div>
    <div class="page-content fade-in-up">
        <div class="ibox">
            <div class="ibox-body">
                <div id="example-table_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4">
                    <div class="row">
                        <div class="col-sm-12 col-md-6">
                            <div class="dataTables_length" id="example-table_length">
                                <label>
                                    Show
                                    <select name="pageSize" id="pageSize" aria-controls="example-table" class="form-control form-control-sm" onchange="changePageSize()">
                                        <option value="10" @(ViewBag.PageSize == 10 ? "selected" : "")>10</option>
                                        <option value="25" @(ViewBag.PageSize == 25 ? "selected" : "")>25</option>
                                        <option value="50" @(ViewBag.PageSize == 50 ? "selected" : "")>50</option>
                                        <option value="100" @(ViewBag.PageSize == 100 ? "selected" : "")>100</option>
                                    </select> entries
                                </label>
                            </div>
                        </div>
                        <div class="col-sm-12 col-md-6">
                            <div id="example-table_filter" class="dataTables_filter">
                                <form action="@Url.Action("Index", "User")" method="get">
                                    <label>Search:</label>
                                    <input type="search" name="searchTerm" class="form-control form-control-sm" placeholder="Enter keyword..." value="@ViewBag.SearchTerm">
                                    <button type="submit" class="btn btn-default">Search</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <table class="table table-striped table-bordered table-hover" cellspacing="0" width="100%">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>Location</th>
                                    <th>Capacity</th>
                                    <th>CreatedAt</th>
                                    <th>ActivityDate</th>
                                    <th>Status</th>
                                    <th>Delete</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th>No.</th>
                                    <th>Title</th>
                                    <th>Description</th>
                                    <th>Location</th>
                                    <th>Capacity</th>
                                    <th>CreatedAt</th>
                                    <th>ActivityDate</th>
                                    <th>Status</th>
                                    <th>Delete</th>
                                    <th>Edit</th>
                                </tr>
                            </tfoot>
                            <tbody id="example-table">
                                @{ int i = (ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1; }
                                @foreach (var item in ls)
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@item.Title</td>
                                        <td>@item.Description</td>
                                        <td>@item.Location</td>
                                        <td>@item.Capacity</td>
                                        <td>@(item.CreatedAt?.ToString("yyyy-MM-dd") ?? "")</td>
                                        <td>@(item.ActivityDate.ToString("yyyy-MM-dd") ?? "")</td>
                                        <td>
                                            @if (item.Status == 1)
                                            {
                                                <input type="checkbox" name="Status" id="Status" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" name="Status" id="Status" />
                                            }
                                        </td>
                                        <td>
                                            <a href="deleteExtraActivity?id=@item.ActivityID"><img src="@Url.Content("~/content/Admin/images/trash.png")" alt="delete type" /></a>
                                        </td>

                                        <td>
                                            <a href="EditExtraActivity?id=@item.ActivityID"><img src="@Url.Content("~/content/Admin/images/edit_icon.png")" alt="edit type" /></a>
                                        </td>
                                    </tr>
                                    i++;
                                }
                            </tbody>
                        </table>
                        @{
                            int totalPages = (int)Math.Ceiling((double)ViewBag.TotalRecords / ViewBag.PageSize);
                            int maxPageDisplay = 5; // Số lượng trang tối đa hiển thị
                            int startPage = Math.Max(1, ViewBag.CurrentPage - 2);
                            int endPage = Math.Min(ViewBag.TotalPages, startPage + maxPageDisplay - 1);
                        }
                    </div>
                    <nav aria-label="Page navigation">
                        <ul class="pagination">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = 1, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })">First</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })">Previous</a>
                                </li>
                            }

                            @for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { page = p, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })">@p</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })">Next</a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.TotalPages, pageSize = ViewBag.PageSize, searchTerm = ViewBag.SearchTerm })">Last</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        </div>
    </div>
}

@section subFooter{
    <script>
    function changePageSize() {
        var pageSize = document.getElementById("pageSize").value;
        var currentPage = @ViewBag.CurrentPage;
        window.location.href = "/Product/Index?page=" + currentPage + "&pageSize=" + pageSize;
    }
    </script>
}


