
@{
    ViewBag.Title = "NewExtraRegistration";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
@section subHeader{
}
<div class="page-heading">
    <h1 class="page-title">New User</h1>
</div>
<div class="page-content fade-in-up">
    <div class="row">
        <div class="col-md-6">
            <div class="ibox">
                <div class="ibox-head">
                    <div class="ibox-tools">
                        <a class="ibox-collapse"><i class="fa fa-minus"></i></a>
                        <a class="dropdown-toggle" data-toggle="dropdown"><i class="fa fa-ellipsis-v"></i></a>
                        <div class="dropdown-menu dropdown-menu-right">
                            <a class="dropdown-item">option 1</a>
                            <a class="dropdown-item">option 2</a>
                        </div>
                    </div>
                </div>
                <div class="ibox-body">
                    <form action="/user/createUser" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label>Full Name</label>
                                <input class="form-control" type="text" name="FullName" placeholder="FullName" value="">
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Email</label>
                                <input class="form-control" type="text" name="Email" placeholder="Email" value="">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label>PassWord</label>
                                <input class="form-control" type="password" name="PasswordHash" placeholder="PassWord" value="">
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>PhoneNumber</label>
                                <input class="form-control" type="text" name="PhoneNumber" placeholder="PhoneNumber" value="">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label>Created Date</label>
                                <input class="form-control" type="date" name="CreatedAt" value="">
                            </div>
                            <div class="col-sm-6 form-group">
                                <label>Updated Date</label>
                                <input class="form-control" type="date" name="UpdatedAt" value="">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-6 form-group">
                                <label>Select Trainer</label>
                                <select class="form-control" name="RoleID">
                                    <option selected>select Type</option>
                                    @if (ViewBag.listRole != null)
                                    {
                                        List<OHD_System.Models.Entities.Role> lsTrainer = (List<OHD_System.Models.Entities.Role>)ViewBag.listRole;
                                        foreach (var item in lsTrainer)
                                        {
                                            <option value="@item.RoleID">@item.RoleName</option>
                                        }
                                    }
                                </select>
                                <span style="color: red;text-align:left">@(Session["RegexTrainer"]!=null?Session["RegexTrainer"]:"")</span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="ui-checkbox">Status</label>
                            <input type="checkbox" name="Status" alt="Active or deactive" checked>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-default" type="submit">Submit</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section subFooter{
}




