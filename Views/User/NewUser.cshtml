@{
    ViewBag.Title = "NewUser";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    OHD_System.Models.Entities.User m = new OHD_System.Models.Entities.User();
}

@section subHeader{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        .position-relative {
            position: relative;
        }

        .password-field {
            padding-right: 40px; /* Chừa khoảng trống cho icon */
        }

        .eye-icon {
            position: absolute;
            top: 50%;
            right: 10px; /* Điều chỉnh khoảng cách từ mép phải */
            transform: translateY(-50%);
            cursor: pointer;
            color: #666;
        }

            .eye-icon:hover {
                color: #333;
            }
    </style>

}

@if (Session["m"] != null)
{
    m = (OHD_System.Models.Entities.User)Session["m"];
}

<div class="container-fluid">
    <div class="page-heading text-center">
        <h1 class="page-title">New User</h1>
    </div>
    <div class="page-content fade-in-up d-flex justify-content-center align-items-center mt-4" style="min-height: 100vh;">
        <div class="row w-100 d-flex justify-content-center">
            <div class="col-md-10">
                <div class="ibox">
                    <div class="ibox-body" style="background-color: white; border-radius: 12px; padding: 30px; box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1); width: 100%;">
                        <form action="/user/createUser" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>Full Name</label>
                                    <input class="form-control" type="text" name="FullName" placeholder="Full Name" value="@(m != null ? m.FullName : "")">
                                    <span class="text-danger">@Session["RegexUserName"]</span>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label>Email</label>
                                    <input class="form-control" type="text" name="Email" placeholder="Email" value="@(m != null ? m.Email : "")">
                                    <span class="text-danger">@Session["RegexEmail"]</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>Password</label>
                                    <div class="position-relative">
                                        <input class="form-control password-field" type="password" id="PasswordHash" name="PasswordHash" placeholder="Password">
                                        <i class="fa fa-eye eye-icon" id="eyeIcon1" onclick="togglePassword('PasswordHash', 'eyeIcon1')"></i>
                                    </div>
                                    <span class="text-danger">@Session["RegexPassword"]</span>
                                </div>

                                <div class="col-sm-6 form-group">
                                    <label>Confirm Password</label>
                                    <div class="position-relative">
                                        <input class="form-control password-field" type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Confirm Password">
                                        <i class="fa fa-eye eye-icon" id="eyeIcon2" onclick="togglePassword('ConfirmPassword', 'eyeIcon2')"></i>
                                    </div>
                                    <span class="text-danger">@Session["RegexConfirmPassword"]</span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>Created Date</label>
                                    <input class="form-control" type="date" name="CreatedAt" value="@(m.CreatedAt != null ? ((DateTime)m.CreatedAt).ToString("yyyy-MM-dd") : "")">
                                    <span class="text-danger">@Session["RegexCreatedAt"]</span>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label>Updated Date</label>
                                    <input class="form-control" type="date" name="UpdatedAt" value="@(m.UpdatedAt != null ? ((DateTime)m.UpdatedAt).ToString("yyyy-MM-dd") : "")">
                                    <span class="text-danger">@Session["RegexUpdateAt"]</span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-sm-6 form-group">
                                    <label>Phone Number</label>
                                    <input class="form-control" type="text" name="PhoneNumber" placeholder="Phone Number" value="@(m != null ? m.PhoneNumber : "")">
                                    <span class="text-danger">@Session["RegexPhone"]</span>
                                </div>
                                <div class="col-sm-6 form-group">
                                    <label>Select Role</label>
                                    <select class="form-control" name="RoleID">
                                        <option selected>Select Type</option>
                                        @if (ViewBag.listRole != null)
                                        {
                                            List<OHD_System.Models.Entities.Role> lsTrainer = (List<OHD_System.Models.Entities.Role>)ViewBag.listRole;
                                            foreach (var item in lsTrainer)
                                            {
                                                <option value="@item.RoleID">@item.RoleName</option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger">@Session["RegexRole"]</span>
                                </div>
                            </div>
                            <div class="col-sm-6 form-group d-flex align-items-center">
                                <label class="mr-2">Status</label>
                                <input type="checkbox" name="Status" alt="Active or Deactive" @(m != null && m.Status == 1 ? "checked" : "")>
                            </div>

                            <div class="form-group text-center">
                                <button class="btn btn-primary" type="submit">Submit</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section subFooter{
    <script>
        function togglePassword(inputId, eyeIconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(eyeIconId);

            if (input.type === "password") {
                input.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                input.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
}

